    "lint": "eslint src --ext ts",
    "generate-data": "tsc && node dist/utils/generate-files.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.3.2",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.15.29",
    "@types/ws": "^8.18.1",
    "chai": "^5.2.0",
    "mocha": "11.7.5",
    "tsc-watch": "^6.2.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
